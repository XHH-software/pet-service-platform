# docker compose 使用的环境变量，复制为 .env 后按需修改
#   cp .env.example .env

# 对外端口
APP_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379

# MySQL root 密码（仅供本地/演示使用）
MYSQL_ROOT_PASSWORD=root

# JWT 签名密钥：生产环境必须替换成 32 字节以上的随机串
# 生成方式：openssl rand -base64 32
JWT_SECRET=please-change-this-to-a-32-byte-random-string

# 上传：local（容器内磁盘 + 挂载卷）或 oss（阿里云）
UPLOAD_TYPE=local
UPLOAD_BASE_URL=http://localhost:8080

# 未支付订单自动关闭时间（分钟）
ORDER_TIMEOUT_MINUTES=30

# 允许跨域的来源，逗号分隔；* 表示不限制（仅建议本地使用）
# 生产示例：CORS_ALLOWED_ORIGINS=https://admin.example.com,https://m.example.com
CORS_ALLOWED_ORIGINS=*
